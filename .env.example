# Copiar a .env.local y completar. Solo la URL y la llave publica (anon/publishable).
# La llave service_role NUNCA va aqui ni en el repositorio.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Modo pruebas: «Ya llegué» funciona aunque estés lejos. Debe ser false en el lanzamiento.
VITE_IGNORAR_UBICACION=false
